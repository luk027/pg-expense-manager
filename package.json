{
  "name": "pg-expense-manager-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:mobile": "npm --workspace=apps/mobile run start",
    "start:api": "npm --workspace=apps/api run dev",
    "build:api": "npm --workspace=apps/api run build",
    "typecheck": "npm run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
