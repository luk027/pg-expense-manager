# Neon / PostgreSQL Database URL
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Better Auth Secret
BETTER_AUTH_SECRET=your_super_secret_better_auth_key_here

# Environment
ENVIRONMENT=development
PORT=8787
